# Postgres credentials -- used by the db service to initialize itself
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=tasks

# Connection string used by the app. Host "db" is the compose service name,
# resolved via Docker's internal network -- not localhost.
DATABASE_URL=postgresql://taskuser:taskpass@db:5432/tasks

# Redis, same story: "redis" is the compose service name.
REDIS_URL=redis://redis:6379/0

# Supabase project settings -- Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key

# Anthropic API key -- console.anthropic.com/settings/keys. Used by /tasks/{id}/priority.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Kill switch: set to "false" to disable the /tasks/{id}/priority model call entirely
# (returns 503 instead). Defaults to enabled if unset.
LLM_ENABLED=true

# Stub mode: set to "1" to skip the model call and return a fixed, schema-valid
# response -- zero cost, no network call. Defaults to off (real calls) if unset.
LLM_STUB=0
